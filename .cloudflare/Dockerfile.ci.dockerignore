**/.env*
.dev.vars*
**/.dev.vars*
.git*
**/.git*
*compose*.yml
*compose*.yaml
**/*compose*.yml
**/*compose*.yaml
node_modules
**/node_modules
.cloudflare/staged
**/.cloudflare/staged
.wrangler
**/.wrangler
.next
**/.next
pages-dist
**/pages-dist
out
**/out
dist
**/dist
build
**/build
.pages-prerender
**/.pages-prerender
.pages-fixture-dist
**/.pages-fixture-dist
.turbo
**/.turbo
*.log
**/*.log
