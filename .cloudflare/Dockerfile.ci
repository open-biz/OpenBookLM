# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*

FROM base AS builder
COPY --from=oven/bun:1.3.14 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /source
COPY . .
RUN bun install --frozen-lockfile
ARG PAGES_APP
ARG SOURCE_COMMIT
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_WEB_APP_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_POSTHOG_HOST
ARG NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CDN_URL
ARG NEXT_PUBLIC_LINODE_BUCKET_URL
ARG NEXT_PUBLIC_GOOGLE_API_KEY
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_TELEMETRY_DISABLED=1
RUN node --test .cloudflare/runtime-publisher.test.mjs
RUN node .cloudflare/create-ci-artifact.mjs

FROM base AS publisher
WORKDIR /publisher
COPY .cloudflare/package.json .cloudflare/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY .cloudflare/runtime-publisher.mjs ./runtime-publisher.mjs
COPY --from=builder /artifact /artifact
ARG PAGES_APP
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.title="Cloudflare Pages one-shot publisher" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.cloudflare.pages.project="${PAGES_APP}"
RUN mkdir -p /work /home/node/.config && chown node:node /work /home/node/.config
ENV HOME=/home/node WRANGLER_SEND_METRICS=false CI=true
WORKDIR /work
USER node
HEALTHCHECK NONE
ENTRYPOINT ["node", "/publisher/runtime-publisher.mjs"]
